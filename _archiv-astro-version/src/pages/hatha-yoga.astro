---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Hatha Yoga – Wedemark & Online | beVital InsideOut"
  description="Hatha Yoga verbindet Körperhaltungen, bewusste Atmung und Entspannung. Offene Kurse und zertifizierte Präventionskurse vor Ort oder online."
>

<div class="page-header">
  <div class="container">
    <div class="eyebrow">Yoga · Kraft · Atem · Ruhe</div>
    <h1 class="hero-h1" style="font-size:clamp(2.4rem,4.5vw,4rem);">Hatha <em>Yoga.</em></h1>
    <p class="lead">Hatha Yoga verbindet Körperhaltungen, bewusste Atmung und Entspannung.</p>
  </div>
</div>

<section class="section" style="padding-top:1rem;">
  <div class="container">
    <div class="off-grid fade" style="grid-template-columns:1fr 1fr 1fr; max-width:900px; margin-left:auto; margin-right:auto;">
      <div class="off-card">
        <div class="off-top"><span class="off-icon">🧘</span></div>
        <h3>Offener Kurs</h3>
        <div class="off-sub">Drop-in · Elze</div>
        <p class="off-desc">Dienstag 18:00–19:15 Uhr im Sport- und Tanzhaus Elze. Kein Abo, kein Vertrag.</p>
        <a href="/kurse" class="off-link">Zum Kursplan</a>
      </div>
      <div class="off-card dark">
        <div class="off-top"><span class="off-icon">🏥</span></div>
        <h3>Präventionskurs Wedemark</h3>
        <div class="off-sub">§20 SGB V · Präsenz</div>
        <p class="off-desc">8-Wochen-Kurs vor Ort, zertifiziert. Krankenkasse erstattet bis zu 100%.</p>
        <a href="/praeventionskurse-wedemark" class="off-link">Kurs ansehen</a>
      </div>
      <div class="off-card">
        <div class="off-top"><span class="off-icon">💻</span></div>
        <h3>Präventionskurs Online</h3>
        <div class="off-sub">§20 SGB V · Zoom</div>
        <p class="off-desc">8-Wochen-Kurs live über Zoom, zertifiziert. Krankenkasse erstattet bis zu 100%.</p>
        <a href="/praeventionskurse-online" class="off-link">Kurs ansehen</a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
