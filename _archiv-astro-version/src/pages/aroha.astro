---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="AROHA – Wedemark | beVital InsideOut"
  description="AROHA ist ein fließendes Ganzkörpertraining mit kraftvollen und entspannenden Bewegungsfolgen. Mittwochs im Höpershof."
>

<div class="page-header">
  <div class="container">
    <div class="eyebrow">Ausdauer · Kraft · Entspannung</div>
    <h1 class="hero-h1" style="font-size:clamp(2.4rem,4.5vw,4rem);"><em>AROHA.</em></h1>
    <p class="lead">AROHA ist ein fließendes Ganzkörpertraining mit kraftvollen und entspannenden Bewegungsfolgen.</p>
  </div>
</div>

<section class="section" style="padding-top:1rem;">
  <div class="container">
    <div class="off-grid fade" style="grid-template-columns:1fr; max-width:460px; margin-left:auto; margin-right:auto;">
      <div class="off-card">
        <div class="off-top">
          <span class="off-icon">🔥</span>
          <span class="off-badge">Präsenz</span>
        </div>
        <h3>AROHA</h3>
        <div class="off-sub">YAP – Your Active Place · Höpershof</div>
        <p class="off-desc">Dynamische Bewegung mit klaren, gut nachvollziehbaren Abläufen.</p>
        <ul class="off-features">
          <li>Mittwoch 18:00–18:50 Uhr</li>
        </ul>
        <a href="https://www.fyndery.de/yoga-by-bettina/" target="_blank" class="off-link">Kurs buchen</a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
