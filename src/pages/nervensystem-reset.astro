---
const title = "5-Tage-Nervensystem-Reset | Bettina Kahmann";
---
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content="Fünf Audios, fünf Tage. Jeden Tag eine kurze Einheit, die dein Nervensystem aus dem Dauer-Alarm holt. Kostenlos per E-Mail.">
<meta name="robots" content="index, follow">
<meta property="og:title" content="5-Tage-Nervensystem-Reset">
<meta property="og:description" content="Fünf Audios, fünf Tage. Jeden Tag eine kurze Einheit für dein Nervensystem. Kostenlos.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #FAF6F1; --cream-dark: #F0E8DE;
    --terracotta: #C17B52; --terracotta-dark: #8C492E;
    --plum: #993A74; --sage: #7A9E7E; --text: #3A2E28;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'DM Sans', -apple-system, sans-serif; background: var(--cream); color: var(--text); line-height: 1.65; font-size: 17px; -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 600; line-height: 1.15; color: var(--terracotta-dark); }
  .wrap { max-width: 620px; margin: 0 auto; padding: 0 24px; }
  header { padding: 22px 0; text-align: center; }
  header .brand { font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--terracotta); font-weight: 500; }
  .hero { padding: 28px 0 44px; text-align: center; }
  .eyebrow { display: inline-block; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--plum); font-weight: 700; margin-bottom: 18px; }
  .hero h1 { font-size: clamp(34px, 8vw, 48px); margin-bottom: 20px; }
  .hero p.sub { font-size: 19px; max-width: 480px; margin: 0 auto 28px; }
  .cta-btn { display: inline-block; background: var(--plum); color: #fff; text-decoration: none; font-weight: 700; font-size: 17px; padding: 16px 36px; border-radius: 999px; transition: background 0.2s ease; }
  .cta-btn:hover { background: #7d2f5f; }
  .hero .kostenlos { display: block; margin-top: 12px; font-size: 14px; color: var(--terracotta-dark); }
  .recognition { background: var(--cream-dark); padding: 52px 0; }
  .recognition h2 { font-size: clamp(26px, 6vw, 34px); margin-bottom: 24px; }
  .recognition ul { list-style: none; }
  .recognition li { padding: 10px 0 10px 30px; position: relative; }
  .recognition li::before { content: ""; position: absolute; left: 0; top: 20px; width: 14px; height: 2px; background: var(--terracotta); }
  .recognition p.closer { margin-top: 24px; font-weight: 500; }
  .days { padding: 56px 0; }
  .days h2 { font-size: clamp(26px, 6vw, 34px); margin-bottom: 10px; }
  .days > .wrap > p.intro { margin-bottom: 32px; }
  .day { display: flex; gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--cream-dark); align-items: baseline; }
  .day:last-of-type { border-bottom: none; }
  .day .num { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 30px; font-weight: 600; color: var(--terracotta); min-width: 34px; }
  .day-tag { display: inline-block; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700; color: var(--sage); margin-bottom: 4px; }
  .day h3 { font-size: 21px; margin-bottom: 4px; color: var(--text); }
  .day p { font-size: 16px; }
  .days p.zeit { margin-top: 26px; padding: 16px 20px; background: var(--cream-dark); border-left: 3px solid var(--sage); font-size: 16px; }
  .signup { background: var(--terracotta-dark); color: var(--cream); padding: 56px 0; text-align: center; }
  .signup h2 { color: var(--cream); font-size: clamp(26px, 6vw, 34px); margin-bottom: 12px; }
  .signup p { max-width: 440px; margin: 0 auto 28px; }
  .form-box { max-width: 440px; margin: 0 auto; text-align: left; }
  .form-box ._form_41, .form-box ._form_41 ._form, .form-box ._form_41 form, .form-box ._form_41 ._form-content {
    background: transparent !important; padding: 0 !important; margin: 0 !important; width: 100% !important; max-width: 100% !important; border: none !important; box-shadow: none !important; font-family: 'DM Sans', sans-serif !important;
  }
  .form-box ._form_41 * { font-family: 'DM Sans', sans-serif !important; box-sizing: border-box !important; }
  .form-box ._form_41 ._row, .form-box ._form_41 ._field-wrapper, .form-box ._form_41 ._form_element { margin: 0 0 22px 0 !important; padding: 0 !important; width: 100% !important; }
  .form-box ._form_41 ._form-label, .form-box ._form_41 label:not(._checkbox-label) { display: block !important; color: var(--cream) !important; font-size: 14px !important; font-weight: 500 !important; letter-spacing: 0.04em; margin: 0 0 8px 0 !important; padding: 0 !important; }
  .form-box ._form_41 input[type="text"], .form-box ._form_41 input[type="email"] { width: 100% !important; padding: 16px 18px !important; border: none !important; border-radius: 10px !important; font-size: 17px !important; line-height: 1.4 !important; color: var(--text) !important; background: var(--cream) !important; height: auto !important; margin: 0 !important; }
  .form-box ._form_41 input::placeholder { color: #9a8a80 !important; opacity: 1 !important; }
  .form-box ._form_41 ._checkbox-radio, .form-box ._form_41 ._row._checkbox-radio { display: flex !important; align-items: flex-start !important; gap: 12px !important; }
  .form-box ._form_41 input[type="checkbox"] { width: 20px !important; height: 20px !important; min-width: 20px !important; margin: 3px 0 0 0 !important; accent-color: var(--plum) !important; cursor: pointer; }
  .form-box ._form_41 ._checkbox-radio label, .form-box ._form_41 ._checkbox-radio span, .form-box ._form_41 ._row span { color: var(--cream) !important; font-size: 14px !important; line-height: 1.55 !important; font-weight: 400 !important; }
  .form-box ._form_41 ._submit, .form-box ._form_41 button[type="submit"], .form-box ._form_41 input[type="submit"] { width: 100% !important; background: var(--plum) !important; color: #fff !important; border: none !important; border-radius: 999px !important; padding: 17px !important; font-size: 17px !important; font-weight: 700 !important; letter-spacing: 0.01em; cursor: pointer !important; margin: 6px 0 0 0 !important; transition: background 0.2s ease; height: auto !important; text-transform: none !important; }
  .form-box ._form_41 ._submit:hover, .form-box ._form_41 button[type="submit"]:hover { background: #7d2f5f !important; }
  .form-box ._form_41 ._error-inner { background: var(--cream) !important; color: #a03030 !important; border-radius: 8px !important; padding: 8px 12px !important; font-size: 14px !important; }
  .form-box ._form_41 ._form-thank-you { color: var(--cream) !important; font-size: 19px !important; line-height: 1.5 !important; text-align: center !important; padding: 20px 0 !important; }
  .form-box ._form-branding { display: none !important; }
  .signup .datenschutz { font-size: 13px; margin-top: 18px; opacity: 0.85; }
  .signup .datenschutz a { color: var(--cream); }
  .about { padding: 56px 0; }
  .about .inner { display: flex; gap: 24px; align-items: flex-start; }
  .about h2 { font-size: clamp(24px, 5vw, 30px); margin-bottom: 14px; }
  .about p { margin-bottom: 14px; }
  .about p:last-child { margin-bottom: 0; }
  footer { background: var(--cream-dark); padding: 28px 0; text-align: center; font-size: 14px; }
  footer a { color: var(--terracotta-dark); text-decoration: none; margin: 0 10px; }
  footer a:hover { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>

<header>
  <div class="wrap">
    <span class="brand">Bettina Kahmann · beVital InsideOut</span>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <span class="eyebrow">Kostenlos · 5 Audios · 5 Tage</span>
    <h1>Dein Körper ist müde. Dein Kopf läuft weiter.</h1>
    <p class="sub">Der 5-Tage-Nervensystem-Reset holt dich aus dem Dauer-Alarm. Jeden Tag ein Audio, jede Einheit unter zehn Minuten. Keine Vorkenntnisse, keine Matte nötig.</p>
    <a href="#anmeldung" class="cta-btn">Reset starten</a>
    <span class="kostenlos">Kostenlos. Tag 1 kommt sofort in dein Postfach.</span>
  </div>
</section>

<section class="recognition">
  <div class="wrap">
    <h2>Kennst du das?</h2>
    <ul>
      <li>Du kannst abends nicht abschalten, auch wenn du willst.</li>
      <li>Du bist müde, aber schlafen klappt trotzdem nicht.</li>
      <li>Innere Unruhe, obwohl gar nichts Schlimmes passiert.</li>
      <li>Du funktionierst. Für alle. Seit Jahren.</li>
    </ul>
    <p class="closer">Das ist kein Willensproblem. Dein Nervensystem steht auf Alarm und braucht ein klares Signal, dass es sicher ist. Genau das lernst du in diesen fünf Tagen.</p>
  </div>
</section>

<section class="days">
  <div class="wrap">
    <h2>Das bekommst du</h2>
    <p class="intro">Fünf geführte Audios, jeden Tag eines per E-Mail. Du hörst zu, atmest mit und dein Nervensystem macht den Rest. Das ist Physiologie, keine Esoterik.</p>

    <div class="day">
      <span class="num">1</span>
      <div>
        <span class="day-tag">Atem regulieren</span>
        <h3>Der physiologische Seufzer</h3>
        <p>Du lernst die eine Atemtechnik, die dein Nervensystem in unter zwei Minuten aus dem Alarmmodus holt. Keine Übung. Reine Physiologie.</p>
      </div>
    </div>
    <div class="day">
      <span class="num">2</span>
      <div>
        <span class="day-tag">Vagusnerv aktivieren</span>
        <h3>Summen als Nervensystem-Werkzeug</h3>
        <p>Dein Vagusnerv ist der Hauptschalter deines Ruhesystems. Wir aktivieren ihn direkt, mit einer Technik, die du überall anwenden kannst.</p>
      </div>
    </div>
    <div class="day">
      <span class="num">3</span>
      <div>
        <span class="day-tag">Den Körper befragen</span>
        <h3>Körperscan</h3>
        <p>Du lernst, Spannung zu erkennen, bevor sie sich festsetzt. Keine Entspannungsübung. Körperintelligenz.</p>
      </div>
    </div>
    <div class="day">
      <span class="num">4</span>
      <div>
        <span class="day-tag">Stressreaktion unterbrechen</span>
        <h3>Die Orientierungsreaktion</h3>
        <p>Wie du eine Stressreaktion in dem Moment unterbrichst, in dem sie passiert. Nicht danach. Mittendrin. In 60 Sekunden.</p>
      </div>
    </div>
    <div class="day">
      <span class="num">5</span>
      <div>
        <span class="day-tag">Schlafen</span>
        <h3>Schlafvorbereitung</h3>
        <p>Dein Nervensystem braucht ein Signal, dass der Tag vorbei ist. Diese Übung gibt es ihm und verändert deinen Schlaf.</p>
      </div>
    </div>

    <p class="zeit">Jede Einheit dauert unter zehn Minuten. Du brauchst nur einen Ort, an dem du fünf Minuten ungestört bist.</p>
  </div>
</section>

<section class="signup" id="anmeldung">
  <div class="wrap">
    <h2>Starte deinen Reset</h2>
    <p>Trag deine E-Mail-Adresse ein. Tag 1 kommt sofort, die weiteren Audios folgen an den nächsten vier Tagen.</p>
    <div class="form-box">
      <div class="_form_41"></div>
      <script src="https://bettinakahmann43364.activehosted.com/f/embed.php?id=41" charset="utf-8" is:inline></script>
    </div>
    <p class="datenschutz">Du bekommst die fünf Reset-Audios und danach meinen Newsletter mit Impulsen für dein Nervensystem. Abmeldung jederzeit mit einem Klick. Details in der <a href="/datenschutz">Datenschutzerklärung</a>.</p>
  </div>
</section>

<section class="about">
  <div class="wrap">
    <div class="inner">
      <div>
        <h2>Wer dich begleitet</h2>
        <p>Ich bin Bettina Kahmann, zertifizierte Yogalehrerin und Präventionstrainerin nach §20 SGB V. Seit über 20 Jahren unterrichte ich Bewegung, mit mehr als 7.000 Unterrichtsstunden und über 7.000 Frauen, die ich begleitet habe.</p>
        <p>Ich arbeite mit Frauen, die seit Jahren funktionieren und deren Körper deutliche Signale sendet. Mein Ansatz ist klar und geerdet: Atmung, Haltung und Routinen, die im echten Alltag halten. Ohne Esoterik, ohne Leistungsdruck.</p>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <a href="/impressum">Impressum</a>
    <a href="/datenschutz">Datenschutz</a>
    <a href="/">bettina-kahmann.com</a>
  </div>
</footer>

<script is:inline>
(function () {
  function set(el, props) {
    for (var k in props) { el.style.setProperty(k, props[k], 'important'); }
  }
  function styleForm() {
    var box = document.querySelector('._form_41');
    if (!box || !box.querySelector('form')) return false;
    var cream = '#FAF6F1', plum = '#993A74', text = '#3A2E28';
    var font = "'DM Sans', sans-serif";
    box.querySelectorAll('form, ._form, ._form-content, ._form-inner').forEach(function (el) {
      set(el, { background: 'transparent', padding: '0', margin: '0', width: '100%', 'max-width': '100%', border: 'none', 'box-shadow': 'none', 'font-family': font });
    });
    box.querySelectorAll('._form_element, ._row, ._field-wrapper').forEach(function (el) {
      set(el, { margin: '0 0 22px 0', padding: '0', width: '100%' });
    });
    box.querySelectorAll('._form-label, label').forEach(function (el) {
      if (el.querySelector('input[type="checkbox"]') || el.closest('._checkbox-radio')) return;
      set(el, { color: cream, 'font-size': '14px', 'font-weight': '500', margin: '0 0 8px 0', padding: '0', display: 'block', 'font-family': font });
    });
    box.querySelectorAll('input[type="text"], input[type="email"]').forEach(function (el) {
      set(el, { width: '100%', padding: '16px 18px', border: 'none', 'border-radius': '10px', 'font-size': '17px', color: text, background: cream, height: 'auto', margin: '0', 'font-family': font, 'box-sizing': 'border-box' });
    });
    box.querySelectorAll('input[type="checkbox"]').forEach(function (el) {
      set(el, { width: '20px', height: '20px', 'min-width': '20px', margin: '3px 10px 0 0', 'accent-color': plum });
      var row = el.closest('._checkbox-radio') || el.closest('._row') || el.parentElement;
      if (row) set(row, { display: 'flex', 'align-items': 'flex-start', color: cream });
    });
    box.querySelectorAll('._checkbox-radio label, ._checkbox-radio span, ._row span').forEach(function (el) {
      set(el, { color: cream, 'font-size': '14px', 'line-height': '1.55', 'font-weight': '400', 'font-family': font });
    });
    box.querySelectorAll('button[type="submit"], ._submit, input[type="submit"]').forEach(function (el) {
      set(el, { width: '100%', background: plum, color: '#fff', border: 'none', 'border-radius': '999px', padding: '17px', 'font-size': '17px', 'font-weight': '700', cursor: 'pointer', margin: '6px 0 0 0', height: 'auto', 'text-transform': 'none', 'font-family': font });
    });
    box.querySelectorAll('._form-branding').forEach(function (el) { set(el, { display: 'none' }); });
    box.querySelectorAll('._form-thank-you').forEach(function (el) {
      set(el, { color: cream, 'font-size': '19px', 'text-align': 'center', padding: '20px 0', 'font-family': font });
    });
    return true;
  }
  var tries = 0;
  var timer = setInterval(function () {
    if (styleForm() || ++tries > 60) clearInterval(timer);
  }, 250);
  var mo = new MutationObserver(function () { styleForm(); });
  var target = document.querySelector('._form_41');
  if (target) mo.observe(target, { childList: true, subtree: true });
})();
</script>
</body>
</html>
