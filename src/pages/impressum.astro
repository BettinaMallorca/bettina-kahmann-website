---
import '../styles/global.css';
const title = "Impressum – beVital InsideOut | Bettina Kahmann";
---
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root { --pink: #993a74; --terracotta: #C17B52; --cream: #FAF6F1; --cream-dark: #f0e8de; --dark: #2a1a10; --text: #3a2e24; --text-light: #7a6a5a; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--text); }
  nav.legal { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 1.1rem 3rem; display: flex; justify-content: space-between; align-items: center; background: rgba(250,246,241,0.97); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(153,58,116,0.08); }
  .nav-logo { font-family: 'Cormorant Garamond', serif; font-size: 1.25rem; font-weight: 500; color: var(--text); text-decoration: none; }
  .nav-logo span { color: var(--pink); font-style: italic; }
  main { padding: 9rem 6rem 6rem; max-width: 900px; }
  .eyebrow { font-size: 0.68rem; font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase; color: var(--terracotta); margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.8rem; }
  .eyebrow::before { content: ''; width: 24px; height: 1px; background: var(--terracotta); }
  h1 { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 300; color: var(--text); margin-bottom: 3rem; }
  .lsection { margin-bottom: 2.5rem; }
  .section-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--terracotta); margin-bottom: 0.8rem; }
  .lsection p { font-size: 0.9rem; font-weight: 300; line-height: 1.8; color: var(--text-light); margin-bottom: 0.5rem; }
  .lsection a { color: var(--pink); }
  .contact-box { background: var(--cream-dark); border-left: 4px solid var(--pink); padding: 1.5rem 2rem; border-radius: 2px; margin-top: 2rem; }
  footer.legal { background: var(--dark); padding: 2rem 6rem; color: rgba(255,255,255,0.4); }
  footer.legal a { color: rgba(255,255,255,0.4); text-decoration: none; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; font-size: 0.75rem; }
  @media (max-width: 900px) { nav.legal { padding: 1rem 1.5rem; } main { padding: 7rem 1.5rem 4rem; } footer.legal { padding: 2rem 1.5rem; } }
</style>
</head>
<body>
<nav class="legal"><a href="/" class="nav-logo">beVital <span>InsideOut</span></a></nav>
<main>
  <div class="eyebrow">Rechtliches</div>
  <h1>Impressum</h1>

  <div class="lsection">
    <div class="section-title">Verantwortlich für die Website</div>
    <p>Bettina Kahmann</p>
    <p>Auf dem großen Kampe 29</p>
    <p>30900 Wedemark</p>
    <p>Tel: +49 (0) 5130 960 543</p>
    <p>Internet: <a href="https://www.bettina-kahmann.com" target="_blank">www.bettina-kahmann.com</a></p>
  </div>

  <div class="lsection">
    <div class="section-title">Steuerliche Angaben</div>
    <p>Finanzamt Burgdorf</p>
    <p>Steuer-Nr. 16/121/18345</p>
    <p>Umsatzsteuer-Identifikationsnummer gemäß §27 a Umsatzsteuergesetz: DE323625068</p>
  </div>

  <div class="lsection">
    <div class="section-title">Inhalt der Internetpräsenz</div>
    <p>Bettina Kahmann übernimmt keinerlei Gewähr für die Aktualität, Korrektheit, Vollständigkeit oder Qualität der bereitgestellten Informationen. Alle Angebote sind freibleibend und unverbindlich.</p>
  </div>

  <div class="lsection">
    <div class="section-title">Urheber- und Kennzeichenrecht</div>
    <p>Das Copyright für veröffentlichte, von Bettina Kahmann selbst erstellte Objekte bleibt allein bei Bettina Kahmann. Eine Vervielfältigung oder Verwendung ohne ausdrückliche Zustimmung ist nicht gestattet.</p>
  </div>

  <div class="contact-box">
    <div class="section-title">Kontakt</div>
    <p>Bettina Kahmann · Auf dem großen Kampe 29 · 30900 Wedemark</p>
    <p>Tel.: 05130 / 960 543</p>
    <p>E-Mail: <a href="mailto:info@bettina-kahmann.com">info@bettina-kahmann.com</a></p>
  </div>
</main>
<footer class="legal">
  <div class="footer-bottom">
    <p>© 2026 Bettina Kahmann · beVital InsideOut · Wedemark bei Hannover</p>
    <p><a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a> · <a href="/agb">AGB</a></p>
  </div>
</footer>
</body>
</html>
