---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="FaszienFit Yoga – Live Online | beVital InsideOut"
  description="Eine aktive Verbindung aus Yoga, Mobilisation und faszialen Bewegungsimpulsen. Dienstags live online über Zoom."
>

<div class="page-header">
  <div class="container">
    <div class="eyebrow">Faszien · Mobilität · Yoga</div>
    <h1 class="hero-h1" style="font-size:clamp(2.4rem,4.5vw,4rem);">FaszienFit <em>Yoga.</em></h1>
    <p class="lead">Eine aktive Verbindung aus Yoga, Mobilisation und faszialen Bewegungsimpulsen.</p>
  </div>
</div>

<section class="section" style="padding-top:1rem;">
  <div class="container">
    <div class="off-grid fade" style="grid-template-columns:1fr; max-width:460px; margin-left:auto; margin-right:auto;">
      <div class="off-card">
        <div class="off-top">
          <span class="off-icon">〰️</span>
          <span class="off-badge">Live Online</span>
        </div>
        <h3>FaszienFit Yoga</h3>
        <div class="off-sub">Dienstags über Zoom</div>
        <p class="off-desc">Mobilität, Kräftigung und faszienorientierte Bewegung – dienstags live online.</p>
        <ul class="off-features">
          <li>Dienstag 09:00–09:50 Uhr</li>
        </ul>
        <a href="https://www.fyndery.de/book_course/calendar/7239/1/#calendar_tab" target="_blank" class="off-link">Kurs buchen (Fyndery)</a>
      </div>
    </div>
  </div>
</section>

</BaseLayout>
