---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

<div id="prog"></div>

<!-- COOKIE -->
<div id="cookie">
  <div class="cookie-txt">
    <strong>Diese Website verwendet Cookies.</strong>
    Wir nutzen Analyse-Cookies, um zu verstehen, wie die Website genutzt wird. Du kannst selbst entscheiden.
    <a href="/datenschutz">Datenschutzerklärung</a>
  </div>
  <div class="c-btns">
    <button class="c-decline" onclick="cookieDo('declined')">Nur notwendige</button>
    <button class="c-accept" onclick="cookieDo('accepted')">Alle akzeptieren</button>
  </div>
</div>

<!-- NAV -->
<nav id="nav">
  <a href="/" class="brand">
    <span class="brand-top">Bettina Kahmann</span>
    <span class="brand-sub">beVital InsideOut</span>
  </a>
  <ul class="nav-links">
    <li><a href="/#angebote">Angebote</a></li>
    <li><a href="/#about">Über mich</a></li>
    <li><a href="/#kurse">Kurse</a></li>
    <li><a href="/#reset">RESET</a></li>
    <li><a href="/retreat">Retreat</a></li>
    <li><a href="/#guides">Guides</a></li>
    <li><a href="https://www.fyndery.de/book_course/calendar/7239/1/#calendar_tab" target="_blank" class="btn-nav">Kurs buchen</a></li>
  </ul>
  <button class="hamburger" onclick="toggleMob()" aria-label="Menü">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- MOBILE MENU -->
<div id="mob-menu">
  <a href="/#angebote">Angebote</a>
  <a href="/#about">Über mich</a>
  <a href="/#kurse">Kurse</a>
  <a href="/#reset">RESET</a>
  <a href="/retreat">Retreat</a>
  <a href="/#guides">Guides</a>
  <a href="https://www.fyndery.de/book_course/calendar/7239/1/#calendar_tab" target="_blank" class="btn-nav">Kurs buchen</a>
</div>

<slot />

<!-- ══════════════════════════════════
     NEWSLETTER
══════════════════════════════════ -->
<div class="nl-section">
  <div class="eyebrow">Newsletter</div>
  <h2>Bleib in Verbindung.</h2>
  <p>Praxistipps für Nervensystem, Yoga und Alltag – direkt in dein Postfach.</p>
  <a href="https://bettinakahmann43364.activehosted.com/f/27" target="_blank" class="btn-pink">Newsletter abonnieren</a>
</div>

<!-- ══════════════════════════════════
     FOOTER
══════════════════════════════════ -->
<footer>
  <div class="footer-grid">
    <div>
      <div class="f-brand">beVital <em>InsideOut</em></div>
      <p>Yoga, Atemarbeit und Nervensystem-Regulation.<br>Vor Ort in der Wedemark und online.</p>
      <br>
      <a href="https://instagram.com/be_vital_insideout" target="_blank">IG @be_vital_insideout</a>
    </div>
    <div>
      <h4>Vor Ort</h4>
      <ul>
        <li><a href="https://maps.google.com/?q=Kuckucksweg+90,+30900+Wedemark" target="_blank">Sport- und Tanzhaus, Elze<br>Kuckucksweg 90 · Wedemark</a></li>
        <li style="margin-top:0.8rem;"><a href="mailto:info@bettina-kahmann.com">info@bettina-kahmann.com</a></li>
        <li><a href="https://wa.me/message/QNJNZJTTJGKAC1" target="_blank">WhatsApp</a></li>
      </ul>
    </div>
    <div>
      <h4>Angebote</h4>
      <ul>
        <li><a href="/#angebote">LIVE Yoga Studio</a></li>
        <li><a href="/#kurse">Präventionskurse §20</a></li>
        <li><a href="/retreat">Retreat Mallorca</a></li>
        <li><a href="/#reset">5-Tage RESET</a></li>
        <li><a href="/#guides">Gratis Guides</a></li>
        <li><a href="https://www.fyndery.de/book_course/calendar/7239/1/#calendar_tab" target="_blank">Kurs buchen</a></li>
      </ul>
    </div>
    <div>
      <h4>Rechtliches</h4>
      <ul>
        <li><a href="mailto:info@bettina-kahmann.com">Kontakt</a></li>
        <li><a href="https://instagram.com/be_vital_insideout" target="_blank">Instagram</a></li>
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
        <li><a href="/agb">AGB</a></li>
        <li><button onclick="localStorage.removeItem('bvconsent'); location.reload();" style="background:none;border:none;padding:0;color:rgba(250,246,241,0.38);cursor:pointer;font-family:inherit;font-size:0.82rem;font-weight:300;transition:color 0.2s;" onmouseover="this.style.color='#FAF6F1'" onmouseout="this.style.color='rgba(250,246,241,0.38)'">Cookie-Einstellungen</button></li>
      </ul>
    </div>
  </div>
  <div class="footer-bot">
    <p>© 2026 Bettina Kahmann · beVital InsideOut · Wedemark bei Hannover</p>
  </div>
</footer>

<script>
  // Progress bar
  window.addEventListener('scroll', () => {
    const pct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight) * 100;
    document.getElementById('prog').style.width = Math.min(pct,100) + '%';
    document.getElementById('nav').classList.toggle('shadow', window.scrollY > 30);
  });

  // Mobile menu
  function toggleMob() { document.getElementById('mob-menu').classList.toggle('open'); }
  function closeMob() { document.getElementById('mob-menu').classList.remove('open'); }
  document.querySelectorAll('#mob-menu a').forEach(a => a.addEventListener('click', closeMob));

  // Cookie
  const CK = 'bvconsent';
  function cookieDo(v) { localStorage.setItem(CK, v); document.getElementById('cookie').classList.add('gone'); }
  window.cookieDo = cookieDo;
  window.toggleMob = toggleMob;
  if (localStorage.getItem(CK)) document.getElementById('cookie').classList.add('gone');
  else setTimeout(() => document.getElementById('cookie').classList.remove('gone'), 700);
  document.getElementById('cookie').classList.add('gone'); // hide initially

  // Fade in on scroll
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.08 });
  document.querySelectorAll('.fade').forEach(el => obs.observe(el));
</script>

</body>
</html>
